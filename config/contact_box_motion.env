# Contact-box motion configuration.
#
# These defaults are intentionally conservative. Edit this file instead of
# editing each contact-box motion script.
#
# Safety reminders:
# - Increase speed gradually.
# - Test plan-only first.
# - Keep a hand near the emergency stop during supervised execution.
# - Do not increase speed while the suction issue is unresolved.
# - Do not increase press speed aggressively.

# Joint-space reset / saved-pose movement speed.
CONTACT_BOX_RESET_VELOCITY_SCALING=0.06
CONTACT_BOX_RESET_ACCELERATION_SCALING=0.06

# Cartesian approach speed. The staged/contact scripts preserve their existing
# conservative profile while these values remain at the template defaults. Edit
# these values to intentionally override the approach speed from this file.
CONTACT_BOX_APPROACH_VELOCITY_SCALING=0.06
CONTACT_BOX_APPROACH_ACCELERATION_SCALING=0.06

# Optional press-in speed.
CONTACT_BOX_PRESS_VELOCITY_SCALING=0.001
CONTACT_BOX_PRESS_ACCELERATION_SCALING=0.001

# Cartesian planning parameters.
CONTACT_BOX_CARTESIAN_EEF_STEP=0.0005
CONTACT_BOX_CARTESIAN_JUMP_THRESHOLD=0.0
CONTACT_BOX_CARTESIAN_MIN_FRACTION=0.99

# Safety limits. The one-shot direct script preserves its existing wider
# true-30cm-to-contact envelope while these remain at the template defaults;
# editing these values intentionally overrides that envelope.
CONTACT_BOX_MAX_WRIST_TARGET_DISTANCE=0.5
CONTACT_BOX_PRESS_MAX_WRIST_TARGET_DISTANCE=0.010
CONTACT_BOX_RESET_MAX_JOINT_DELTA_RAD=1.50
CONTACT_BOX_APPROACH_MAX_JOINT_DELTA_RAD=1.20
CONTACT_BOX_PRESS_MAX_JOINT_DELTA_RAD=0.03

# Contact/standoff settings.
CONTACT_BOX_DEFAULT_STANDOFF_M=0.002
CONTACT_BOX_DEFAULT_PRESS_DEPTH_M=0.003
CONTACT_BOX_MAX_PRESS_DEPTH_M=0.005

# Target offset applied to the fresh live YOLO/depth contact pose before
# planning the direct contact approach. The default -0.030 Z offset shifts the
# suction target 3 cm downward in base_link so the active top two suction cups
# land nearer the solid center cover area instead of small holes.
# These are development/deployment calibration values and must be visually
# verified on the actual setup.
CONTACT_BOX_TARGET_OFFSET_X_M=0.010
CONTACT_BOX_TARGET_OFFSET_Y_M=0.000
CONTACT_BOX_TARGET_OFFSET_Z_M=-0.030

# Target offset examples:
# CONTACT_BOX_TARGET_OFFSET_X_M=0.000
# CONTACT_BOX_TARGET_OFFSET_Y_M=0.000
# CONTACT_BOX_TARGET_OFFSET_Z_M=-0.030
#
# The default -0.030 Z offset shifts the target 3 cm downward in base_link.
# Tune these values only after visual verification of where the suction cups land.

# Maximum allowed lateral error between the current suction TCP estimate and
# the adjusted suction target before starting the direct approach. This must be
# larger than the configured intentional target offset when the ready pose is
# not laterally aligned to the adjusted target. The current 3 cm downward target
# offset produces about 2.9 cm lateral error from the true 30 cm ready pose.
# Default 0.050 m allows that offset while still blocking unexpectedly large
# target jumps.
CONTACT_BOX_MAX_PRE_APPROACH_LATERAL_ERROR_M=0.1

# Cover pickup-out settings. This sequence starts only after the robot is
# already pressed onto the cover and suction_on has already succeeded. It lifts
# in base_link +Z, then pulls opposite the contact-box approach direction.
# Pull-out direction is derived from the current wrist3_link tool +Z axis.
# The action-server prototype projects this direction onto base_link XY and
# holds lifted Z constant during pull-out to avoid hook re-latching.
# Pull-out distance is intentionally unset until visually/mechanically
# calibrated; the pickup-out script fails closed if it is blank.
CONTACT_BOX_COVER_LIFT_Z_M=0.014
CONTACT_BOX_MIN_ACTUAL_LIFT_DELTA_Z_M=0.0005
CONTACT_BOX_COVER_PULL_OUT_AXIS=opposite_tool_axis
CONTACT_BOX_COVER_PULL_OUT_M=0.050
CONTACT_BOX_SUCTION_SETTLE_DELAY_SEC=2.0

# Cover table-mount placement offset. This is separate from the contact-box
# YOLO/depth target offset above. It is applied at runtime to both recorded
# mount poses so cover_mount_approach stays aligned above cover_mount_place.
# Keep these as small base_link calibration nudges; each axis is limited to
# +/-0.050 m by scripts/load_contact_box_motion_config.sh.
CONTACT_BOX_COVER_MOUNT_OFFSET_X_M=0.000
CONTACT_BOX_COVER_MOUNT_OFFSET_Y_M=0.000
CONTACT_BOX_COVER_MOUNT_OFFSET_Z_M=-0.000

# Perception/contact-pose acquisition settings.
CONTACT_BOX_POSE_SAMPLE_COUNT=5
CONTACT_BOX_POSE_SAMPLE_TIMEOUT_SEC=5.0
CONTACT_BOX_POSE_MAX_SPREAD_M=0.015
CONTACT_BOX_MAX_LIVE_VS_MANUAL_DELTA_M=0.020

# Faster development testing example:
# CONTACT_BOX_RESET_VELOCITY_SCALING=0.01
# CONTACT_BOX_RESET_ACCELERATION_SCALING=0.01
# CONTACT_BOX_APPROACH_VELOCITY_SCALING=0.005
# CONTACT_BOX_APPROACH_ACCELERATION_SCALING=0.005
# CONTACT_BOX_PRESS_VELOCITY_SCALING=0.002
# CONTACT_BOX_PRESS_ACCELERATION_SCALING=0.002
