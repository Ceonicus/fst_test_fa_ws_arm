# STATUS is read-only and does not command suction hardware.
# A_ON requires successful /initialize_suction preparation first.
# This project workflow uses suction A / top two cups only; suction B / bottom
# cups and ALL_ON are intentionally disabled. A_ON always forces B OFF.
# A_OFF and ALL_OFF both send the EVS08 stop-all/break-vacuum MoveGripper
# command and do not use ActGripper(1,0).
int8 STATUS=0
int8 A_ON=1
int8 A_OFF=2
int8 B_ON=3
int8 B_OFF=4
int8 ALL_ON=5
int8 ALL_OFF=6

int8 command
---
bool success
string message
