std::string trim(const std::string & input)
{
  const auto first = input.find_first_not_of(" \t\r\n");
  if (first == std::string::npos) {
    return "";
  }
  const auto last = input.find_last_not_of(" \t\r\n");
  return input.substr(first, last - first + 1);
}

double vector_norm(const Vector3 & vector)
{
  return std::sqrt(vector.x * vector.x + vector.y * vector.y + vector.z * vector.z);
}

Vector3 add(const Vector3 & a, const Vector3 & b)
{
  return Vector3{a.x + b.x, a.y + b.y, a.z + b.z};
}

Vector3 subtract(const Vector3 & a, const Vector3 & b)
{
  return Vector3{a.x - b.x, a.y - b.y, a.z - b.z};
}

Vector3 scale(const Vector3 & vector, const double scalar)
{
  return Vector3{vector.x * scalar, vector.y * scalar, vector.z * scalar};
}

Vector3 cross(const Vector3 & a, const Vector3 & b)
{
  return Vector3{
    a.y * b.z - a.z * b.y,
    a.z * b.x - a.x * b.z,
    a.x * b.y - a.y * b.x};
}

double dot(const Vector3 & a, const Vector3 & b)
{
  return a.x * b.x + a.y * b.y + a.z * b.z;
}

geometry_msgs::msg::Quaternion normalized_quaternion(geometry_msgs::msg::Quaternion q)
{
  const double norm = std::sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w);
  if (!std::isfinite(norm) || norm < 1e-12) {
    throw std::runtime_error("invalid quaternion");
  }
  q.x /= norm;
  q.y /= norm;
  q.z /= norm;
  q.w /= norm;
  return q;
}

Vector3 rotate_vector_by_quaternion(
  const geometry_msgs::msg::Quaternion & raw_q,
  const Vector3 & vector)
{
  const auto q = normalized_quaternion(raw_q);
  const Vector3 q_vec{q.x, q.y, q.z};
  const Vector3 t = scale(cross(q_vec, vector), 2.0);
  return add(add(vector, scale(t, q.w)), cross(q_vec, t));
}

geometry_msgs::msg::Pose make_pose(
  const Vector3 & position,
  const geometry_msgs::msg::Quaternion & orientation)
{
  geometry_msgs::msg::Pose pose;
  pose.position.x = position.x;
  pose.position.y = position.y;
  pose.position.z = position.z;
  pose.orientation = normalized_quaternion(orientation);
  return pose;
}

double elapsed_sec(const std::chrono::steady_clock::time_point & start)
{
  return std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
}

enum class GoalMode
{
  DryRun,
  PlanOnly,
  Execute
};

std::string stage_feedback_label(const std::string & stage, const GoalMode mode)
{
  if (mode == GoalMode::PlanOnly) {
    return stage + " PLAN_ONLY";
  }
  if (mode == GoalMode::DryRun) {
    return stage + " DRY_RUN";
  }
  return stage;
}
