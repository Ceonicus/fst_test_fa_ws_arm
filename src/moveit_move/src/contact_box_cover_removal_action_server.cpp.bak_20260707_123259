int main(int argc, char * argv[])
{
  rclcpp::init(argc, argv);
  auto node = std::make_shared<ContactBoxCoverRemovalActionServer>();
  try {
    node->initialize();
  } catch (const std::exception & exc) {
    RCLCPP_ERROR(
      node->get_logger(),
      "Failed to initialize contact-box cover-removal action server: %s. "
      "Use the provided launch file so MoveIt parameters are loaded.",
      exc.what());
    rclcpp::shutdown();
    return 1;
  }

  rclcpp::executors::MultiThreadedExecutor executor;
  executor.add_node(node);
  try {
    executor.spin();
  } catch (const std::exception & exc) {
    RCLCPP_ERROR(node->get_logger(), "Exception during action-server spin: %s", exc.what());
  }
  executor.cancel();
  if (rclcpp::ok()) {
    rclcpp::shutdown();
  }
  return 0;
}
