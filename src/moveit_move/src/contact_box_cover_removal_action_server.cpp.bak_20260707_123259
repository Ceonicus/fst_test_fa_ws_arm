  MotionConfig load_motion_config(const std::string & path) const
  {
    MotionConfig config;
    std::ifstream input(path);
    if (!input) {
      RCLCPP_WARN(get_logger(), "Missing contact-box motion config %s; using built-in defaults.", path.c_str());
      return config;
    }

    std::map<std::string, std::string> values;
    std::string line;
    while (std::getline(input, line)) {
      const auto comment = line.find('#');
      if (comment != std::string::npos) {
        line = line.substr(0, comment);
      }
      line = trim(line);
      if (line.empty()) {
        continue;
      }
      const auto equals = line.find('=');
      if (equals == std::string::npos) {
        continue;
      }
      values[trim(line.substr(0, equals))] = trim(line.substr(equals + 1));
    }

    auto get_double = [&](const std::string & name, const double current) {
        const auto it = values.find(name);
        if (it == values.end() || it->second.empty()) {
          return current;
        }
        return std::stod(it->second);
      };
    auto get_int = [&](const std::string & name, const int current) {
        const auto it = values.find(name);
        if (it == values.end() || it->second.empty()) {
          return current;
        }
        return std::stoi(it->second);
      };
    auto get_string = [&](const std::string & name, const std::string & current) {
        const auto it = values.find(name);
        if (it == values.end() || it->second.empty()) {
          return current;
        }
        return it->second;
      };

    config.reset_velocity_scaling = get_double("CONTACT_BOX_RESET_VELOCITY_SCALING", config.reset_velocity_scaling);
    config.reset_acceleration_scaling = get_double("CONTACT_BOX_RESET_ACCELERATION_SCALING", config.reset_acceleration_scaling);
    config.approach_velocity_scaling = get_double("CONTACT_BOX_APPROACH_VELOCITY_SCALING", config.approach_velocity_scaling);
    config.approach_acceleration_scaling = get_double("CONTACT_BOX_APPROACH_ACCELERATION_SCALING", config.approach_acceleration_scaling);
    config.press_velocity_scaling = get_double("CONTACT_BOX_PRESS_VELOCITY_SCALING", config.press_velocity_scaling);
    config.press_acceleration_scaling = get_double("CONTACT_BOX_PRESS_ACCELERATION_SCALING", config.press_acceleration_scaling);
    config.cartesian_eef_step = get_double("CONTACT_BOX_CARTESIAN_EEF_STEP", config.cartesian_eef_step);
    config.cartesian_jump_threshold = get_double("CONTACT_BOX_CARTESIAN_JUMP_THRESHOLD", config.cartesian_jump_threshold);
    config.cartesian_min_fraction = get_double("CONTACT_BOX_CARTESIAN_MIN_FRACTION", config.cartesian_min_fraction);
    config.max_wrist_target_distance = get_double("CONTACT_BOX_MAX_WRIST_TARGET_DISTANCE", config.max_wrist_target_distance);
    config.press_max_wrist_target_distance = get_double("CONTACT_BOX_PRESS_MAX_WRIST_TARGET_DISTANCE", config.press_max_wrist_target_distance);
    config.reset_max_joint_delta_rad = get_double("CONTACT_BOX_RESET_MAX_JOINT_DELTA_RAD", config.reset_max_joint_delta_rad);
    config.approach_max_joint_delta_rad = get_double("CONTACT_BOX_APPROACH_MAX_JOINT_DELTA_RAD", config.approach_max_joint_delta_rad);
    config.press_max_joint_delta_rad = get_double("CONTACT_BOX_PRESS_MAX_JOINT_DELTA_RAD", config.press_max_joint_delta_rad);
    config.default_standoff_m = get_double("CONTACT_BOX_DEFAULT_STANDOFF_M", config.default_standoff_m);
    config.default_press_depth_m = get_double("CONTACT_BOX_DEFAULT_PRESS_DEPTH_M", config.default_press_depth_m);
    config.max_press_depth_m = get_double("CONTACT_BOX_MAX_PRESS_DEPTH_M", config.max_press_depth_m);
    config.target_offset_x_m = get_double("CONTACT_BOX_TARGET_OFFSET_X_M", config.target_offset_x_m);
    config.target_offset_y_m = get_double("CONTACT_BOX_TARGET_OFFSET_Y_M", config.target_offset_y_m);
    config.target_offset_z_m = get_double("CONTACT_BOX_TARGET_OFFSET_Z_M", config.target_offset_z_m);
    config.max_pre_approach_lateral_error_m = get_double(
      "CONTACT_BOX_MAX_PRE_APPROACH_LATERAL_ERROR_M", config.max_pre_approach_lateral_error_m);
    config.cover_lift_z_m = get_double("CONTACT_BOX_COVER_LIFT_Z_M", config.cover_lift_z_m);
    config.min_actual_lift_delta_z_m = get_double(
      "CONTACT_BOX_MIN_ACTUAL_LIFT_DELTA_Z_M", config.min_actual_lift_delta_z_m);
    config.cover_pull_out_axis = get_string("CONTACT_BOX_COVER_PULL_OUT_AXIS", config.cover_pull_out_axis);
    config.cover_pull_out_m = get_double("CONTACT_BOX_COVER_PULL_OUT_M", config.cover_pull_out_m);
    config.suction_settle_delay_sec = get_double(
      "CONTACT_BOX_SUCTION_SETTLE_DELAY_SEC", config.suction_settle_delay_sec);
    config.cover_mount_offset_x_m = get_double("CONTACT_BOX_COVER_MOUNT_OFFSET_X_M", config.cover_mount_offset_x_m);
    config.cover_mount_offset_y_m = get_double("CONTACT_BOX_COVER_MOUNT_OFFSET_Y_M", config.cover_mount_offset_y_m);
    config.cover_mount_offset_z_m = get_double("CONTACT_BOX_COVER_MOUNT_OFFSET_Z_M", config.cover_mount_offset_z_m);
    config.pose_sample_count = get_int("CONTACT_BOX_POSE_SAMPLE_COUNT", config.pose_sample_count);
    config.pose_sample_timeout_sec = get_double("CONTACT_BOX_POSE_SAMPLE_TIMEOUT_SEC", config.pose_sample_timeout_sec);
    config.pose_max_spread_m = get_double("CONTACT_BOX_POSE_MAX_SPREAD_M", config.pose_max_spread_m);
    config.max_live_vs_manual_delta_m = get_double(
      "CONTACT_BOX_MAX_LIVE_VS_MANUAL_DELTA_M", config.max_live_vs_manual_delta_m);

    validate_motion_config(config);
    return config;
  }

  void validate_motion_config(const MotionConfig & config) const
  {
    auto require_range = [](const double value, const double low, const double high, const char * name) {
        if (!std::isfinite(value) || value < low || value > high) {
          throw std::runtime_error(std::string("unsafe contact-box config value: ") + name);
        }
      };
    require_range(config.reset_velocity_scaling, 0.000001, 0.20, "CONTACT_BOX_RESET_VELOCITY_SCALING");
    require_range(config.reset_acceleration_scaling, 0.000001, 0.20, "CONTACT_BOX_RESET_ACCELERATION_SCALING");
    require_range(config.approach_velocity_scaling, 0.000001, 0.20, "CONTACT_BOX_APPROACH_VELOCITY_SCALING");
    require_range(config.approach_acceleration_scaling, 0.000001, 0.20, "CONTACT_BOX_APPROACH_ACCELERATION_SCALING");
    require_range(config.press_velocity_scaling, 0.000001, 0.20, "CONTACT_BOX_PRESS_VELOCITY_SCALING");
    require_range(config.press_acceleration_scaling, 0.000001, 0.20, "CONTACT_BOX_PRESS_ACCELERATION_SCALING");
    require_range(config.cartesian_eef_step, 0.000001, 0.005, "CONTACT_BOX_CARTESIAN_EEF_STEP");
    require_range(config.cartesian_jump_threshold, 0.0, 10.0, "CONTACT_BOX_CARTESIAN_JUMP_THRESHOLD");
    require_range(config.cartesian_min_fraction, 0.000001, 1.0, "CONTACT_BOX_CARTESIAN_MIN_FRACTION");
    require_range(config.max_wrist_target_distance, 0.000001, 0.700, "CONTACT_BOX_MAX_WRIST_TARGET_DISTANCE");
    require_range(config.press_max_wrist_target_distance, 0.000001, 0.100, "CONTACT_BOX_PRESS_MAX_WRIST_TARGET_DISTANCE");
    require_range(config.reset_max_joint_delta_rad, 0.000001, 2.000, "CONTACT_BOX_RESET_MAX_JOINT_DELTA_RAD");
    require_range(config.approach_max_joint_delta_rad, 0.000001, 2.000, "CONTACT_BOX_APPROACH_MAX_JOINT_DELTA_RAD");
    require_range(config.press_max_joint_delta_rad, 0.000001, 0.200, "CONTACT_BOX_PRESS_MAX_JOINT_DELTA_RAD");
    require_range(config.default_standoff_m, 0.0, 0.020, "CONTACT_BOX_DEFAULT_STANDOFF_M");
    require_range(config.default_press_depth_m, 0.0, config.max_press_depth_m, "CONTACT_BOX_DEFAULT_PRESS_DEPTH_M");
    require_range(config.max_press_depth_m, 0.000001, 0.010, "CONTACT_BOX_MAX_PRESS_DEPTH_M");
    require_range(config.target_offset_x_m, -0.100, 0.100, "CONTACT_BOX_TARGET_OFFSET_X_M");
    require_range(config.target_offset_y_m, -0.100, 0.100, "CONTACT_BOX_TARGET_OFFSET_Y_M");
    require_range(config.target_offset_z_m, -0.100, 0.100, "CONTACT_BOX_TARGET_OFFSET_Z_M");
    require_range(config.max_pre_approach_lateral_error_m, 0.000001, 0.100, "CONTACT_BOX_MAX_PRE_APPROACH_LATERAL_ERROR_M");
    require_range(config.cover_lift_z_m, 0.000001, 0.050, "CONTACT_BOX_COVER_LIFT_Z_M");
    require_range(
      config.min_actual_lift_delta_z_m, 0.0, config.cover_lift_z_m,
      "CONTACT_BOX_MIN_ACTUAL_LIFT_DELTA_Z_M");
    require_range(config.cover_pull_out_m, 0.000001, 0.250, "CONTACT_BOX_COVER_PULL_OUT_M");
    require_range(config.suction_settle_delay_sec, 0.0, 10.0, "CONTACT_BOX_SUCTION_SETTLE_DELAY_SEC");
    if (config.cover_pull_out_axis != "opposite_tool_axis") {
      throw std::runtime_error("unsafe contact-box config value: CONTACT_BOX_COVER_PULL_OUT_AXIS");
    }
    require_range(config.cover_mount_offset_x_m, -0.050, 0.050, "CONTACT_BOX_COVER_MOUNT_OFFSET_X_M");
    require_range(config.cover_mount_offset_y_m, -0.050, 0.050, "CONTACT_BOX_COVER_MOUNT_OFFSET_Y_M");
    require_range(config.cover_mount_offset_z_m, -0.050, 0.050, "CONTACT_BOX_COVER_MOUNT_OFFSET_Z_M");
    if (config.pose_sample_count <= 0 || config.pose_sample_count > 100) {
      throw std::runtime_error("unsafe contact-box config value: CONTACT_BOX_POSE_SAMPLE_COUNT");
    }
    require_range(config.pose_sample_timeout_sec, 0.000001, 60.0, "CONTACT_BOX_POSE_SAMPLE_TIMEOUT_SEC");
    require_range(config.pose_max_spread_m, 0.000001, 0.100, "CONTACT_BOX_POSE_MAX_SPREAD_M");
    require_range(config.max_live_vs_manual_delta_m, 0.0, 1.000, "CONTACT_BOX_MAX_LIVE_VS_MANUAL_DELTA_M");
  }

  std::map<std::string, RecordedPose> load_recorded_poses(const std::string & path) const
  {
    const std::string text = read_text_file(path);
    return {
      {"cover_mount_approach", parse_recorded_pose(text, "cover_mount_approach")},
      {"cover_mount_place", parse_recorded_pose(text, "cover_mount_place")}};
  }

  static std::string read_text_file(const std::string & path)
  {
    std::ifstream input(path);
    if (!input) {
      throw std::runtime_error("failed to open " + path);
    }
    std::ostringstream buffer;
    buffer << input.rdbuf();
    return buffer.str();
  }

  RecordedPose parse_recorded_pose(const std::string & text, const std::string & name) const
  {
    const std::string key = "\"" + name + "\"";
    const auto key_pos = text.find(key);
    if (key_pos == std::string::npos) {
      throw std::runtime_error("missing recorded pose " + name);
    }
    const auto object_start = text.find('{', key_pos);
    const auto object_end = find_matching_brace(text, object_start);
    const std::string block = text.substr(object_start, object_end - object_start + 1);

    RecordedPose pose;
    pose.joints = parse_joint_state(block, name);
    pose.position = parse_vector_object(block, "translation_m", name);
    pose.orientation = parse_quaternion_object(block, "rotation_xyzw", name);
    pose.orientation = normalized_quaternion(pose.orientation);
    return pose;
  }

  static std::size_t find_matching_brace(const std::string & text, const std::size_t open_pos)
  {
    if (open_pos == std::string::npos || text[open_pos] != '{') {
      throw std::runtime_error("invalid JSON-like object");
    }
    int depth = 0;
    bool in_string = false;
    bool escaped = false;
    for (std::size_t i = open_pos; i < text.size(); ++i) {
      const char c = text[i];
      if (in_string) {
        if (escaped) {
          escaped = false;
        } else if (c == '\\') {
          escaped = true;
        } else if (c == '"') {
          in_string = false;
        }
        continue;
      }
      if (c == '"') {
        in_string = true;
      } else if (c == '{') {
        depth += 1;
      } else if (c == '}') {
        depth -= 1;
        if (depth == 0) {
          return i;
        }
      }
    }
    throw std::runtime_error("unterminated JSON-like object");
  }

  static std::string extract_named_object(
    const std::string & block,
    const std::string & name)
  {
    const std::string key = "\"" + name + "\"";
    const auto key_pos = block.find(key);
    if (key_pos == std::string::npos) {
      throw std::runtime_error("missing object " + name);
    }
    const auto object_start = block.find('{', key_pos);
    const auto object_end = find_matching_brace(block, object_start);
    return block.substr(object_start, object_end - object_start + 1);
  }

  static double extract_number(const std::string & block, const std::string & name)
  {
    const std::regex number_regex(
      "\"" + name + "\"\\s*:\\s*(-?(?:[0-9]+\\.?[0-9]*|\\.[0-9]+)(?:[eE][-+]?[0-9]+)?)");
    std::smatch match;
    if (!std::regex_search(block, match, number_regex)) {
      throw std::runtime_error("missing numeric field " + name);
    }
    return std::stod(match[1].str());
  }

  static Vector3 parse_vector_object(
    const std::string & block,
    const std::string & object_name,
    const std::string & pose_name)
  {
    const auto object = extract_named_object(block, object_name);
    Vector3 vector{
      extract_number(object, "x"),
      extract_number(object, "y"),
      extract_number(object, "z")};
    if (!std::isfinite(vector.x) || !std::isfinite(vector.y) || !std::isfinite(vector.z)) {
      throw std::runtime_error("non-finite " + object_name + " in " + pose_name);
    }
    return vector;
  }

  static geometry_msgs::msg::Quaternion parse_quaternion_object(
    const std::string & block,
    const std::string & object_name,
    const std::string & pose_name)
  {
    const auto object = extract_named_object(block, object_name);
    geometry_msgs::msg::Quaternion q;
    q.x = extract_number(object, "x");
    q.y = extract_number(object, "y");
    q.z = extract_number(object, "z");
    q.w = extract_number(object, "w");
    if (!std::isfinite(q.x) || !std::isfinite(q.y) || !std::isfinite(q.z) || !std::isfinite(q.w)) {
      throw std::runtime_error("non-finite " + object_name + " in " + pose_name);
    }
    return q;
  }

  static std::map<std::string, double> parse_joint_state(
    const std::string & block,
    const std::string & pose_name)
  {
    const auto joint_state = extract_named_object(block, "joint_state");
    const std::regex names_regex("\"names\"\\s*:\\s*\\[([^\\]]+)\\]");
    const std::regex positions_regex("\"positions\"\\s*:\\s*\\[([^\\]]+)\\]");
    std::smatch names_match;
    std::smatch positions_match;
    if (!std::regex_search(joint_state, names_match, names_regex) ||
      !std::regex_search(joint_state, positions_match, positions_regex))
    {
      throw std::runtime_error("invalid joint_state in " + pose_name);
    }
    std::vector<std::string> names;
    const std::string names_text = names_match[1].str();
    const std::regex name_regex("\"([^\"]+)\"");
    for (auto it = std::sregex_iterator(names_text.begin(), names_text.end(), name_regex);
      it != std::sregex_iterator(); ++it)
    {
      names.push_back((*it)[1].str());
    }
    std::vector<double> positions;
    std::stringstream stream(positions_match[1].str());
    std::string token;
    while (std::getline(stream, token, ',')) {
      positions.push_back(std::stod(trim(token)));
    }
    if (names.size() != positions.size()) {
      throw std::runtime_error("joint_state names/positions size mismatch in " + pose_name);
    }
    std::map<std::string, double> joints;
    for (std::size_t i = 0; i < names.size(); ++i) {
      joints[names[i]] = positions[i];
    }
    for (const auto & joint : {"j1", "j2", "j3", "j4", "j5", "j6"}) {
      if (joints.find(joint) == joints.end() || !std::isfinite(joints.at(joint))) {
        throw std::runtime_error("missing or invalid joint " + std::string(joint) + " in " + pose_name);
      }
    }
    return joints;
  }

